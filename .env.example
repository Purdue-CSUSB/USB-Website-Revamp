# --- Database -----------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=InstagramPosts

# --- Picking which scraped posts are events -----------------------------------
GROQ_API_KEY=gsk_replace_with_your_own_key
GROQ_MODEL=qwen/qwen3.6-27b

# --- Instagram scraping -------------------------------------------------------
# The sync job authenticates from a stored session, not from these credentials.
# Instagram answers a password login from a datacenter IP with a checkpoint only
# a human can clear, so CI never logs in: run `python backend/seed_ig_session.py`
# here, on a residential connection, and the session it stores in MongoDB is what
# the nightly Action replays.
IG_PROFILE=purdueusb
IG_USERNAME=
IG_PASSWORD=

# Optional. Set if the account has 2FA, so the seeding script can generate its
# own authenticator code instead of prompting for one.
IG_TOTP_SECRET=

# Optional. Base64 session blob from `seed_ig_session.py --print`, mirrored into
# the IG_SESSION repository secret so a run can start without the database copy.
IG_SESSION=

# Optional. Proxy DSN (http://user:pass@host:port). Instagram trusts a stable IP;
# set the same value here and in CI to make the runner look like this machine.
IG_PROXY=

# Optional escape hatch. Password logins are enabled off-CI and disabled on it;
# set to true/false to override that.
IG_ALLOW_PASSWORD_LOGIN=

# --- Deployed site ------------------------------------------------------------
# Used by `npm run keepalive` to ping the live API so Atlas never idles out. In CI
# this comes from the SITE_URL repository *variable* instead - the URL is public,
# so it is not a secret.
SITE_URL=https://purdueusb.com
